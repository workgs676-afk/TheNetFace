rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // 2. Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.displayName is string && data.displayName.size() <= 50 &&
             data.email is string && data.email.size() <= 100 &&
             data.createdAt == request.time;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'authorPhoto', 'imageURL', 'caption', 'createdAt', 'likesCount', 'commentsCount']) &&
             data.keys().size() <= 10 &&
             data.authorId == request.auth.uid &&
             data.imageURL is string && data.imageURL.size() <= 500 &&
             data.caption is string && data.caption.size() <= 2000 &&
             data.createdAt == request.time &&
             data.likesCount is int && data.likesCount == 0 &&
             data.commentsCount is int && data.commentsCount == 0;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['postId', 'authorId', 'authorName', 'authorPhoto', 'content', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.authorId == request.auth.uid &&
             data.content is string && data.content.size() <= 1000 &&
             data.createdAt == request.time;
    }

    function isValidLike(data) {
      return data.keys().hasAll(['userId', 'postId', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['participants', 'updatedAt']) &&
             data.participants.size() == 2 &&
             request.auth.uid in data.participants;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'createdAt']) &&
             data.senderId == request.auth.uid &&
             data.text is string && data.text.size() <= 2000 &&
             data.createdAt == request.time;
    }

    // 3. Collection Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio']) &&
        incoming().displayName is string && incoming().displayName.size() <= 50
      );
    }

    match /posts/{postId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Social feed or profile posts
      allow create: if isSignedIn() && isEmailVerified() && isValidId(postId) && isValidPost(incoming());
      allow update: if isSignedIn() && (
        // Action: Edit Caption
        (isOwner(existing().authorId) && incoming().diff(existing()).affectedKeys().hasOnly(['caption'])) ||
        // Action: Stats update
        (incoming().diff(existing()).affectedKeys().hasAny(['likesCount', 'commentsCount']) && 
         incoming().authorId == existing().authorId && 
         incoming().createdAt == existing().createdAt)
      );
      allow delete: if isSignedIn() && isOwner(existing().authorId);

      // Sub-collections
      match /comments/{commentId} {
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isEmailVerified() && isValidId(commentId) && isValidComment(incoming());
        allow update: if isSignedIn() && isOwner(existing().authorId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['content']);
        allow delete: if isSignedIn() && isOwner(existing().authorId);
      }

      match /likes/{userId} {
        allow get: if isSignedIn();
        allow create: if isSignedIn() && isOwner(userId) && isValidLike(incoming());
        allow delete: if isSignedIn() && isOwner(userId);
      }
    }

    match /conversations/{conversationId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && isValidConversation(incoming());
      allow update: if isSignedIn() && request.auth.uid in existing().participants &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
      
      match /messages/{messageId} {
        allow list: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants && isValidMessage(incoming());
      }
    }
  }
}
